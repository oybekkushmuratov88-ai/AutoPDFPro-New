<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoCAD 2021, 2022, 2023 and 2024 (R24.0-R24.3, binary compatible, .NET Framework 4.8).
    Compiled against the AutoCAD 2021 reference assemblies, so it uses only API that exists in all four.
    Source: src/AutoPDF.Cad (see CadHost.targets). Output: artifacts\AutoPDFPro.bundle\Contents\Windows\R24.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoPDF.AutoCAD</AssemblyName>
    <DefineConstants>$(DefineConstants);ACAD;ACAD_R24</DefineConstants>
    <CadHostDescription>AutoCAD 2021-2024 (R24)</CadHostDescription>
  </PropertyGroup>

  <Import Project="..\AutoPDF.Cad\CadHost.targets" />

  <PropertyGroup>
    <CadBundleDir>$(RepoRoot)\artifacts\AutoPDFPro.bundle</CadBundleDir>
    <CadHostStageDir>$(CadBundleDir)\Contents\Windows\R24</CadHostStageDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only (AutoCAD supplies the real DLLs at run time). R24.0 = AutoCAD 2021. -->
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
