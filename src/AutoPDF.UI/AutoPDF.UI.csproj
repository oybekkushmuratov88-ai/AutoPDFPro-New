<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WPF user interface (Uzbek / Russian / English). The views are composed in C# (no XAML), so every binding target,
    style and template is checked by the compiler and there are no runtime XAML parse errors inside
    the CAD host. The project has no CAD references: windows can be previewed with tools/AutoPDF.UiDemo.

    Two builds:
      net48                         AutoCAD 2021-2024, ZWCAD 2024-2026 (.NET Framework hosts)
      net8.0-windows10.0.19041.0    AutoCAD 2025-2026 (.NET 8 host); the Windows SDK projection provides
                                    Windows.Data.Pdf for the preview.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>AutoPDF.UI</RootNamespace>
    <AssemblyName>AutoPDF.UI</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Lets the Windows-only targets build on Linux/macOS CI too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <!-- Windows.Data.Pdf (built into Windows 10/11) renders the PDF preview; no native PDF library needed. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPDF.Core\AutoPDF.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Author photo for the header badge and the About window (loaded with GetManifestResourceStream). -->
    <EmbeddedResource Include="Assets\author.jpg" LogicalName="AutoPDF.UI.Assets.author.jpg" />
  </ItemGroup>
</Project>
