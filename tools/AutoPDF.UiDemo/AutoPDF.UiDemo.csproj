<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stand-alone preview of the plug-in windows with sample data (no AutoCAD needed). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AutoPDF.UiDemo</RootNamespace>
    <AssemblyName>AutoPDF.UiDemo</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoPDF.Core\AutoPDF.Core.csproj" />
    <ProjectReference Include="..\..\src\AutoPDF.UI\AutoPDF.UI.csproj" />
  </ItemGroup>
</Project>
